{
  "name": "opc",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "bun run --filter @opc/web dev",
    "dev:api": "bun run --filter @opc/api dev",
    "dev:admin": "bun run --filter @opc/admin dev",
    "admin:create:local": "node apps/api/scripts/create-admin.ts",
    "build": "bun run build:web && bun run build:api && bun run build:admin-worker",
    "build:web": "bun run --filter @opc/web build",
    "build:api": "bun run --filter @opc/api build",
    "build:admin": "bun run --filter @opc/admin build",
    "build:admin-worker": "bun run build:admin && bun run --filter @opc/api build:admin-worker",
    "preview:admin": "bun run --filter @opc/api preview:admin",
    "preview": "bun run --filter @opc/web preview",
    "db:seed": "node scripts/seed.mjs",
    "db:migrate:local": "bun run --filter @opc/web db:migrate:local",
    "check": "bun run --filter '@opc/*' check",
    "test": "bun run --filter '@opc/*' test"
  },
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.4.4"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}

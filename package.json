{
  "name": "opc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "pnpm --filter @opc/web run dev",
    "dev:api": "pnpm --filter @opc/api run dev",
    "build": "pnpm run build:web && pnpm run build:api",
    "build:web": "pnpm --filter @opc/web run build",
    "build:api": "pnpm --filter @opc/api run build",
    "preview": "pnpm --filter @opc/web run preview",
    "start:api": "pnpm --filter @opc/api run start",
    "db:seed": "node scripts/seed.mjs",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test"
  },
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=12.14.0"
  }
}

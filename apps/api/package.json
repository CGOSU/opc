{
  "name": "@opc/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    },
    "./credential-rules": "./src/modules/auth/credentials.ts"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 3001 --persist-to ../web/.wrangler/state",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:admin-worker": "wrangler deploy --env admin-preview --dry-run --outdir dist/admin-preview",
    "preview:admin": "wrangler dev --env admin-preview --local --ip localhost --port 3002 --persist-to ../web/.wrangler/state",
    "check": "tsc --noEmit",
    "test": "node ../web/scripts/prepare-d1.mjs && vitest run",
    "admin:create:local": "node scripts/create-admin.ts"
  },
  "dependencies": {
    "@opc/db": "workspace:*",
    "elysia": "1.4.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261119.1",
    "@elysiajs/eden": "1.4.9",
    "@inquirer/password": "5.3.0",
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}

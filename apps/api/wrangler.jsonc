{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opc-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "vars": { "ADMIN_ORIGIN": "http://localhost:5173" },
  "d1_databases": [
    {
      "binding": "CONTENT",
      "database_name": "opc-content-local",
      // Same local database identity and migrations as the Astro Worker.
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "../web/.wrangler/migrations",
      "remote": false,
    },
  ],
  "env": {
    "admin-preview": {
      "name": "opc-admin-local",
      "vars": { "ADMIN_ORIGIN": "http://localhost:3002" },
      "assets": {
        "directory": "../admin/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api", "/api/*", "/health"],
      },
      "d1_databases": [
        {
          "binding": "CONTENT",
          "database_name": "opc-content-local",
          "database_id": "00000000-0000-4000-8000-000000000001",
          "migrations_dir": "../web/.wrangler/migrations",
          "remote": false,
        },
      ],
    },
  },
}

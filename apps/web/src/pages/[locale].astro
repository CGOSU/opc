---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header.astro";
import StudioIllustration from "../components/StudioIllustration.astro";
import NoteCard from "../components/NoteCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getHome, type Locale } from "../lib/home";
export function getStaticPaths() {
  return ["zh", "en"].map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const { content: c, noindex, headerMenu, footerMenu } = getHome(locale);
---

<SiteLayout
  title={`${c.title} — ${c.name}`}
  description={c.description}
  locale={locale}
  noindex={noindex}
  skip={c.skip}
>
  <Header content={c} locale={locale} menu={headerMenu} />
  <main id="main" class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="tiny-square"></span>
          {c.eyebrow}
        </p>
        <h1 id="hero-title">
          {c.headline[0]}
          <br />
          <span>{c.headline[1]}</span>
        </h1>
        <p class="hero-intro">{c.intro}</p>
        <div class="hero-actions">
          <a class="button primary" href="#notes">
            {c.read}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button secondary" href="#work">
            {c.work}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="hero-footnote">
          AI VIDEO <span>/</span> WEB <span>/</span> MINI APPS
        </p>
      </div>
      <figure class="studio-art">
        <StudioIllustration hero />
        <figcaption>{c.illustration}</figcaption>
      </figure>
    </section>
    <section id="notes" class="section notes-section">
      <div class="section-heading">
        <h2>{c.noteLabel}</h2>
        <div
          class="note-filters"
          role="group"
          aria-label={locale === "zh" ? "筛选技术笔记" : "Filter field notes"}
        >
          <button type="button" data-filter="all" aria-pressed="true">
            {locale === "zh" ? "全部" : "All"}
          </button>
          {[...new Set(c.articles.map((article) => article.category))].map(
            (category) => (
              <button type="button" data-filter={category} aria-pressed="false">
                {category}
              </button>
            ),
          )}
        </div>
      </div>
      <div class="notes-grid">
        {c.articles.map((article) => (
          <NoteCard article={article} sample={c.sample} preview={c.preview} />
        ))}
      </div>
    </section>
    <section id="work" class="section">
      <div class="section-heading">
        <h2>{c.projectLabel}</h2>
      </div>
      <div class="projects-grid">
        {c.projects.map((project) => (
          <ProjectCard project={project} concept={c.concept} />
        ))}
      </div>
    </section>
    <section id="services" class="section services-section">
      <div class="section-heading">
        <h2>{locale === "zh" ? "服务能力" : "Services"}</h2>
      </div>
      <div class="services-list">
        {c.services.map((service, i) => (
          <article>
            <svg
              class="service-icon"
              viewBox="0 0 32 32"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              {i === 0 ? (
                <>
                  <rect x="3" y="7" width="19" height="18" rx="2" />
                  <path d="m22 12 7-4v16l-7-4M10 12l7 4-7 4z" />
                </>
              ) : i === 1 ? (
                <path d="m10 8-8 8 8 8m12-16 8 8-8 8M19 3l-6 26" />
              ) : (
                <>
                  <rect x="3" y="3" width="10" height="10" rx="2" />
                  <rect x="19" y="3" width="10" height="10" rx="2" />
                  <rect x="3" y="19" width="10" height="10" rx="2" />
                  <rect x="19" y="19" width="10" height="10" rx="2" />
                </>
              )}
            </svg>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <span class="service-arrow" aria-hidden="true">
              ↗
            </span>
          </article>
        ))}
      </div>
    </section>
    <section id="about" class="section about-section">
      <div>
        <p class="eyebrow">{c.aboutLabel}</p>
        <h2>{c.aboutTitle}</h2>
      </div>
      <p>{c.aboutText}</p>
    </section>
    <section id="contact" class="contact-section">
      <div>
        <p class="eyebrow">LET’S MAKE SOMETHING</p>
        <h2>{c.contactTitle}</h2>
        <p>{c.contactText}</p>
      </div>
      <div class="contact-status">
        <span class="unavailable">
          <span aria-hidden="true">○</span>
          {c.contactEmpty}
        </span>
        <p>{c.contactNote}</p>
      </div>
    </section>
  </main>
  <footer class="site-footer container">
    <div class="footer-main">
      <div>
        <a class="brand" href={`/${locale}/`}>
          <img src="/goose-placeholder.svg" width="27" height="30" alt="" />
          {c.name}
        </a>
        <p>{c.footer}</p>
      </div>
      <nav aria-label={c.footerNav}>
        {footerMenu.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a
          href={locale === "zh" ? "/en/" : "/zh/"}
          lang={locale === "zh" ? "en" : "zh-Hans"}
        >
          {locale === "zh" ? "English ↗" : "中文 ↗"}
        </a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>{c.notice}</p>
      <a href="#top">{c.back} ↑</a>
    </div>
  </footer>
</SiteLayout>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-category]");
  const grid = document.querySelector(".notes-grid");
  filters.forEach((button) =>
    button.addEventListener("click", () => {
      const category = button.dataset.filter;
      filters.forEach((item) =>
        item.setAttribute("aria-pressed", String(item === button)),
      );
      cards.forEach((card) => {
        card.hidden = category !== "all" && card.dataset.category !== category;
      });
      grid?.classList.toggle("is-filtered", category !== "all");
    }),
  );
  document.querySelector(".note-filters")?.classList.add("is-ready");
</script>

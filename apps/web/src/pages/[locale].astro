---
import { env } from "cloudflare:workers";
import EditorialCards from "../components/EditorialCards.astro";
import StudioIllustration from "../components/StudioIllustration.astro";
import EditorialLayout from "../layouts/EditorialLayout.astro";
import {
  articleLocale,
  articlesPath,
  articleUnavailable,
  listArticles,
} from "../lib/articles";
import {
  editorialCopy,
  loadEditorialSite,
  publishedHomeIndexPolicy,
} from "../lib/editorial-site";
import { articleTopics, featuredPractice, topicsPath } from "../lib/topics";

export const prerender = false;
const locale = articleLocale(Astro.params.locale);
if (!locale) return new Response("Not found", { status: 404 });
if (!env.CONTENT) return articleUnavailable();
const c = editorialCopy(locale);
const other = locale === "zh" ? "en" : "zh";
let editorial, latest, practice, home, labels;
try {
  [editorial, latest, home] = await Promise.all([
    loadEditorialSite(env.CONTENT, locale),
    listArticles(env.CONTENT, locale, 6),
    env.CONTENT.prepare(
      `SELECT noindex FROM (${publishedHomeIndexPolicy}) WHERE locale = ?`,
    )
      .bind(locale)
      .first<number>("noindex"),
  ]);
  const ids = latest.map((a) => a.content_id);
  [practice, labels] = await Promise.all([
    featuredPractice(env.CONTENT, locale, ids),
    articleTopics(env.CONTENT, locale, ids),
  ]);
} catch {
  return articleUnavailable();
}
Astro.response.headers.set("Cache-Control", "no-store");
const archive = articlesPath(locale);
const topics = topicsPath(locale);
---

<EditorialLayout
  title={editorial.name === c.name ? c.title : `${c.title} — ${editorial.name}`}
  description={c.description}
  {locale}
  {editorial}
  noindex={home === 1}
  alternate={{ locale: other, path: `/${other}/` }}
>
  <main id="main" class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="tiny-square"></span> DEVELOPMENT · ENGINEERING · OPEN
          SOURCE
        </p>
        <h1 id="hero-title">
          {c.heading[0]}
          <br />
          <span>{c.heading[1]}</span>
        </h1>
        <p class="hero-intro">{c.description}</p>
        <div class="hero-actions">
          <a class="button primary" href={archive}>
            {c.archive} <span aria-hidden="true">↗</span>
          </a>
          {editorial.topics.length > 0 && (
            <a class="button secondary" href={topics}>
              {c.topics} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
      <figure class="studio-art">
        <StudioIllustration hero />
      </figure>
    </section>
    <section id="notes" class="section notes-section">
      <div class="section-heading">
        <h2>{c.latest}</h2>
      </div>
      {latest.length ? (
        <EditorialCards
          {locale}
          entries={latest.map((entry) => ({
            ...entry,
            topic: labels.get(entry.content_id),
          }))}
        />
      ) : (
        <p>{c.empty}</p>
      )}
    </section>
    {editorial.topics.length > 0 && (
      <section class="section">
        <div class="section-heading">
          <h2>{c.topicHeading}</h2>
        </div>
        <p>{c.topicIntro}</p>
        <EditorialCards {locale} entries={editorial.topics} />
      </section>
    )}
    {practice.length > 0 && (
      <section class="section">
        <div class="section-heading">
          <h2>{c.practice}</h2>
        </div>
        <p>{c.practiceIntro}</p>
        <EditorialCards {locale} entries={practice} />
      </section>
    )}
    <section id="about" class="section about-section">
      <div id="services">
        <h2>{c.about}</h2>
      </div>
      <div id="contact">
        <p>{c.aboutIntro}</p>
        <p id="work">{c.emptyWork}</p>
      </div>
    </section>
  </main>
</EditorialLayout>

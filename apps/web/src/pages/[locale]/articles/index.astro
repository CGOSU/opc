---
import { env } from "cloudflare:workers";
import EditorialLayout from "../../../layouts/EditorialLayout.astro";
import {
  articleDate,
  articleLocale,
  articlesPath,
  articleUnavailable,
  listArticles,
} from "../../../lib/articles";
import { editorialCopy, loadEditorialSite } from "../../../lib/editorial-site";
import "../../../styles/reading.css";

export const prerender = false;

const locale = articleLocale(Astro.params.locale);
if (!locale) return new Response("Not found", { status: 404 });
if (!env.CONTENT) return articleUnavailable();
let articles, editorial;
try {
  [articles, editorial] = await Promise.all([
    listArticles(env.CONTENT, locale),
    loadEditorialSite(env.CONTENT, locale),
  ]);
} catch {
  return articleUnavailable();
}
Astro.response.headers.set("Cache-Control", "no-store");

const zh = locale === "zh";
const c = editorialCopy(locale);
const title = zh ? "技术文章" : "Technical Articles";
const description = zh
  ? "按发布日期浏览技术教程与工程实践。"
  : "Browse technical tutorials and engineering notes in publication order.";
const other = zh ? ("en" as const) : ("zh" as const);
const seo = {
  path: articlesPath(locale),
  alternates: [
    { locale, path: articlesPath(locale) },
    { locale: other, path: articlesPath(other) },
  ],
};
---

<EditorialLayout
  {locale}
  {title}
  {description}
  {seo}
  {editorial}
  alternate={{ locale: other, path: articlesPath(other) }}
>
  <main id="main" class="container reading-page">
    <header class="reading-head">
      <div class="reading-head__copy">
        <span class="pop-badge pop-badge--sun">
          {zh ? "文章归档" : "ARCHIVE"}
        </span>
        <h1>
          <span class="marker">{title}</span>
        </h1>
        <p class="reading-summary">{description}</p>
      </div>
      <a class="nh-btn" href={`/${locale}/search/`}>
        {c.search} <span aria-hidden="true">→</span>
      </a>
    </header>

    {articles.length > 0 ? (
      <ul class="archive">
        {articles.map((article) => (
          <li>
            <time
              datetime={new Date(article.first_published_at_ms).toISOString()}
            >
              {articleDate(article.first_published_at_ms, locale)}
            </time>
            <h2>
              <a href={article.path}>{article.title}</a>
            </h2>
            {article.summary && <p>{article.summary}</p>}
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty-state pop-card">
        <img
          class="empty-state__goose"
          src="/goose-placeholder.svg"
          width="64"
          height="70"
          alt=""
        />
        <p>
          {zh
            ? "暂时没有已发布的文章。"
            : "No articles have been published yet."}
        </p>
      </div>
    )}
  </main>
</EditorialLayout>

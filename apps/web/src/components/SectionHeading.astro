---
interface Props { label: string; title: string; intro?: string; number: string }
const {label, title, intro, number} = Astro.props;
---
<div class="section-heading"><div><p class="eyebrow"><span class="section-number">{number}</span>{label}</p><h2>{title}</h2></div>{intro && <p class="section-intro">{intro}</p>}</div>

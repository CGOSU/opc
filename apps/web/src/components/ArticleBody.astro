---
import type { ArticleHeading } from "../lib/article-markdown";
import type { Locale } from "../lib/home";

interface Props {
  headings: ArticleHeading[];
  html: string;
  locale: Locale;
}
const { headings, html, locale } = Astro.props;
const zh = locale === "zh";
const tocLabel = zh ? "文章目录" : "On this page";
---

<div class:list={["reader", { "with-toc": headings.length }]}>
  {headings.length > 0 && (
    <nav class="toc pop-card" aria-label={tocLabel}>
      <h2>{tocLabel}</h2>
      <ol>
        {headings.map(({ id, label, level }) => (
          <li class:list={{ nested: level > 2 }}>
            <a href={`#${id}`}>{label}</a>
          </li>
        ))}
      </ol>
    </nav>
  )}
  <div
    class="prose pop-card"
    data-copy={zh ? "复制代码" : "Copy"}
    data-copied={zh ? "已复制" : "Copied"}
    data-copy-error={zh ? "复制失败" : "Copy failed"}
    set:html={html}
  />
</div>

<script>
  const clipboard = navigator.clipboard;
  if (clipboard) {
    for (const prose of document.querySelectorAll<HTMLElement>(
      ".prose[data-copy]",
    )) {
      const status = document.createElement("span");
      status.className = "copy-status";
      status.setAttribute("role", "status");
      prose.append(status);
      for (const code of prose.querySelectorAll("pre > code")) {
        const pre = code.parentElement!;
        const wrapper = document.createElement("div");
        const button = document.createElement("button");
        wrapper.className = "code-block";
        button.type = "button";
        button.className = "code-copy";
        button.textContent = prose.dataset.copy!;
        pre.before(wrapper);
        wrapper.append(pre, button);
        button.addEventListener("click", async () => {
          status.textContent = "";
          try {
            await clipboard.writeText(code.textContent ?? "");
            button.textContent = prose.dataset.copied!;
            status.textContent = prose.dataset.copied!;
            setTimeout(() => {
              button.textContent = prose.dataset.copy!;
            }, 1800);
          } catch {
            status.textContent = prose.dataset.copyError!;
          }
        });
      }
    }
  }
</script>

<style>
  .reader {
    display: grid;
    gap: 24px;
    align-items: start;
  }

  .toc {
    padding: 18px 20px;
    min-width: 0;
  }

  .toc h2 {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.03em;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 2px dashed var(--paper-dim);
  }

  .toc ol {
    list-style: none;
    display: grid;
    gap: 6px;
  }

  .toc .nested {
    padding-inline-start: 14px;
  }

  .toc a {
    display: inline-block;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
    transition: color 150ms;
  }

  .toc a:hover {
    color: var(--sky);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose {
    min-width: 0;
    padding: clamp(20px, 4vw, 38px);
    font-size: 16.5px;
    line-height: 1.8;
    overflow-wrap: anywhere;
    border-radius: var(--radius);
    box-shadow: var(--shadow-btn);
  }

  .prose :global(> * + *) {
    margin-block-start: 1.15em;
  }

  .prose :global(h2, h3, h4, h5, h6) {
    margin-block-start: 1.65em;
    margin-block-end: 0.45em;
    color: var(--ink);
  }

  .prose :global(h2) {
    font-size: clamp(21px, 3vw, 27px);
    padding-bottom: 8px;
    border-bottom: 2px dashed var(--paper-dim);
  }

  .prose :global(h3) {
    font-size: clamp(18px, 2.4vw, 22px);
  }

  .prose :global(> :first-child) {
    margin-block-start: 0;
  }

  .prose :global(ul, ol) {
    padding-inline-start: 1.5em;
  }

  .prose :global(li + li) {
    margin-block-start: 0.35em;
  }

  .prose :global(a) {
    color: var(--ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--sun);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
    transition: color 150ms;
  }

  .prose :global(a:hover) {
    color: var(--sky);
  }

  .prose :global(blockquote) {
    padding: 14px 18px;
    background: var(--paper);
    border: var(--line-thin);
    border-inline-start: 6px solid var(--sun);
    border-radius: var(--radius-icon);
    color: var(--ink-soft);
  }

  .prose :global(img) {
    height: auto;
    border: var(--line-thin);
    border-radius: var(--radius-icon);
    box-shadow: var(--shadow-card);
  }

  .prose :global(table, pre) {
    max-width: 100%;
    overflow-x: auto;
  }

  .prose :global(table) {
    display: block;
    border-collapse: collapse;
    border-radius: var(--radius-icon);
  }

  .prose :global(th) {
    background: var(--sun-soft);
    font-weight: 800;
  }

  .prose :global(th, td) {
    border: var(--line-thin);
    padding: 8px 14px;
    text-align: left;
  }

  .prose :global(pre) {
    margin: 0;
    padding: 16px 18px;
    background: var(--code-bg);
    color: var(--code-fg);
    border: var(--line-thin);
    border-radius: var(--radius-icon);
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.65;
  }

  .prose :global(:not(pre) > code) {
    padding: 2px 7px;
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--sun-soft);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
  }

  .prose :global(.code-block) {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .prose :global(.code-copy) {
    justify-self: end;
    padding: 5px 14px;
    min-height: 36px;
    font-size: 12.5px;
    font-weight: 800;
    background: var(--sun);
    color: var(--ink);
    border: var(--line-thin);
    border-radius: var(--radius-icon);
    box-shadow: 2.5px 2.5px 0 var(--ink);
    transition:
      transform 180ms var(--spring),
      box-shadow 180ms var(--spring);
  }

  .prose :global(.code-copy:hover) {
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .prose :global(.code-copy:active) {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  .prose :global(.copy-status:not(:empty)) {
    display: block;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .prose
    :global(
      .hljs-keyword,
      .hljs-built_in,
      .hljs-section,
      .hljs-type,
      .hljs-tag
    ) {
    color: #93c5fd;
  }

  .prose :global(.hljs-string, .hljs-attr, .hljs-attribute, .hljs-regexp) {
    color: #86efac;
  }

  .prose :global(.hljs-number, .hljs-literal, .hljs-variable) {
    color: #fde047;
  }

  .prose :global(.hljs-comment, .hljs-quote) {
    color: #9ca3af;
  }

  @media (min-width: 960px) {
    .reader.with-toc {
      grid-template-columns: minmax(0, 72ch) minmax(220px, 1fr);
      column-gap: 32px;
    }

    .toc {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--nav-h) + 34px);
      max-height: calc(100vh - var(--nav-h) - 56px);
      overflow-y: auto;
    }

    .prose {
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>

---
import { articlesPath } from "../lib/articles";
import { editorialCopy } from "../lib/editorial-site";
import type { Locale, MenuItem } from "../lib/home";

interface Props {
  name: string;
  locale: Locale;
  menu: MenuItem[];
  alternate?: { locale: Locale; path: string };
  currentPath?: string;
}

const { name, locale, menu, alternate, currentPath = "" } = Astro.props;
const c = editorialCopy(locale);
const homeHref = `/${locale}/`;
const navItems: MenuItem[] = [{ label: c.home, href: homeHref }, ...menu];

function isCurrent(href: string): boolean {
  if (href.includes("#")) return false;
  if (href === homeHref) return currentPath === homeHref;
  return currentPath === href || currentPath.startsWith(href);
}
---

<header class="site-nav">
  <div class="site-nav__bar">
    <a class="site-nav__brand" href={homeHref} aria-label={name}>
      <span class="site-nav__logo-wrap">
        <img
          class="site-nav__logo"
          src="/goose-placeholder.svg"
          width="24"
          height="26"
          alt=""
        />
      </span>
      <span class="site-nav__name">{name}</span>
    </a>

    <nav
      class="site-nav__links"
      aria-label={locale === "zh" ? "主导航" : "Main navigation"}
    >
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-nav__actions">
      <div class="site-nav__more">
        <button
          type="button"
          class="site-nav__more-btn"
          aria-label={c.menu}
          aria-expanded="false"
          aria-controls="site-nav-menu"
          data-open={c.menu}
          data-close={c.close}
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path class="icon-bars" d="M4 6h16M4 12h16M4 18h16" />
            <path class="icon-close" d="m6 6 12 12M6 18 18 6" />
          </svg>
        </button>
        <nav
          id="site-nav-menu"
          class="site-nav__menu"
          aria-label={locale === "zh" ? "移动端导航" : "Mobile navigation"}
          hidden
        >
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              <span>{item.label}</span>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </div>

      {alternate ? (
        <a
          class="site-nav__cta-btn"
          href={alternate.path}
          lang={alternate.locale === "zh" ? "zh-Hans" : "en"}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 0 0 0 18M12 3a14 14 0 0 1 0 18" />
          </svg>
          <span>{alternate.locale === "zh" ? "中文" : "English"}</span>
        </a>
      ) : (
        <a class="site-nav__cta-btn" href={articlesPath(locale)}>
          <span>{c.articles}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("header.site-nav");
  if (header) {
    const syncScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 24);
    };
    syncScroll();
    window.addEventListener("scroll", syncScroll, { passive: true });
  }

  const button = document.querySelector<HTMLButtonElement>(
    ".site-nav__more-btn",
  );
  const menu = document.querySelector<HTMLElement>("#site-nav-menu");
  if (button && menu) {
    const desktop = matchMedia("(min-width: 641px)");
    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute(
        "aria-label",
        (open ? button.dataset.close : button.dataset.open) ?? "Menu",
      );
      menu.hidden = !open;
    };

    button.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("click", (event) => {
      if (
        !menu.hidden &&
        !menu.contains(event.target as Node) &&
        !button.contains(event.target as Node)
      ) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        setOpen(false);
        button.focus();
      }
    });

    desktop.addEventListener("change", () => {
      if (desktop.matches) setOpen(false);
    });
    window.addEventListener("pageshow", () => setOpen(false));
  }
</script>

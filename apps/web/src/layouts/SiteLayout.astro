---
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
  locale: "zh" | "en";
  noindex?: boolean;
  skip: string;
  feed?: string;
  seo?: {
    path?: string;
    alternates?: { locale: "zh" | "en"; path: string }[];
    type?: "article";
    image?: URL;
    imageAlt?: string;
    structuredData?: object[];
  };
}
const {
  title,
  description,
  locale,
  noindex = false,
  skip,
  seo,
  feed,
} = Astro.props;
const canonicalPath = seo ? seo.path : `/${locale}/`;
const canonical =
  Astro.site && canonicalPath ? new URL(canonicalPath, Astro.site) : undefined;
const alternates = seo
  ? (seo.alternates ?? [])
  : [
      { locale: "zh", path: "/zh/" },
      { locale: "en", path: "/en/" },
    ];
const structuredData = seo?.structuredData?.map((entry) =>
  JSON.stringify(entry).replace(/</g, "\\u003c"),
);
---

<!doctype html>
<html lang={locale === "zh" ? "zh-Hans" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff6e9" />
    <link rel="icon" href="/goose-placeholder.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add("has-js");
    </script>
    {(noindex || !Astro.site) && (
      <meta name="robots" content="noindex, follow" />
    )}
    {canonical && <link rel="canonical" href={canonical} />}
    {feed && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title="RSS"
        href={feed}
      />
    )}
    {Astro.site &&
      (!seo || !noindex) &&
      alternates.map((entry) => (
        <link
          rel="alternate"
          hreflang={entry.locale === "zh" ? "zh-Hans" : "en"}
          href={new URL(entry.path, Astro.site)}
        />
      ))}
    {Astro.site && !seo && (
      <link rel="alternate" hreflang="x-default" href={Astro.site} />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={seo?.type ?? "website"} />
    {canonical && <meta property="og:url" content={canonical} />}
    {seo?.image && <meta property="og:image" content={seo.image} />}
    {seo?.image && seo.imageAlt && (
      <meta property="og:image:alt" content={seo.imageAlt} />
    )}
    {seo?.type === "article" && (
      <>
        <meta
          name="twitter:card"
          content={seo.image ? "summary_large_image" : "summary"}
        />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {seo.image && <meta name="twitter:image" content={seo.image} />}
        {seo.image && seo.imageAlt && (
          <meta name="twitter:image:alt" content={seo.imageAlt} />
        )}
      </>
    )}
    {structuredData?.map((entry) => (
      <script is:inline type="application/ld+json" set:html={entry} />
    ))}
  </head>
  <body>
    <div id="top" class="page-top" aria-hidden="true"></div>
    <a class="skip-link" href="#main">
      {skip}
    </a>
    <slot />
    <script>
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      if (items.length) {
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduced || !("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-revealed"));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-revealed");
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
          );
          items.forEach((el) => observer.observe(el));
        }
      }
    </script>
  </body>
</html>
